<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-nexusffxiv" value="https://nuget.pkg.github.com/NexusFFXIV/index.json" />
  </packageSources>
  <!-- Required once central package management is on: NuGet raises NU1507 for a
       CPM project with more than one unmapped source, and restore warnings are
       escalated to errors here. Mapping also keeps the private feed from being
       probed for public packages (and vice versa) — the longest matching
       pattern wins, so NexusKit.* resolves from GitHub Packages and everything
       else from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github-nexusffxiv">
      <package pattern="NexusKit.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <github-nexusffxiv>
      <add key="Username" value="nxships" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_PAT%" />
    </github-nexusffxiv>
  </packageSourceCredentials>
</configuration>
